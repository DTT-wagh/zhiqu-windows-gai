#!/usr/bin/env node
const childProcess = require('child_process');

function git(args) {
  return childProcess.execFileSync('git', args, { encoding: 'utf8' }).trim();
}

const branch = git(['branch', '--show-current']);
if (branch === 'main') {
  console.error('Blocked: commit on main. Create or switch to a feature branch.');
  process.exit(1);
}

const staged = git(['diff', '--cached', '--name-only']).split(/\r?\n/).filter(Boolean);
if (staged.some((file) => /(^|\/)\.env$|^server\/data\/|^server\/logs\//.test(file))) {
  console.error('Blocked: secrets, database state, and logs must not be committed.');
  process.exit(1);
}

if (staged.includes('server/zhiqu-server.jar')) {
  console.error('Blocked: the baseline server JAR is immutable. Register a patch in server/patch-src/patch-manifest.json.');
  process.exit(1);
}
