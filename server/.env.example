# Copy this file to .env in the same server folder, then fill in the keys.
# Do not send the completed .env to anyone or commit it to Git.

APP_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
APP_JWT_SECRET=replace-with-a-long-random-local-demo-secret

# Qwen / DashScope features: blind-box image evaluation and related AI tasks.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-flash

# Image generation used only by the "画里藏词" game.
MAGIC_IMAGE_BASE_URL=
MAGIC_IMAGE_API_KEY=
MAGIC_IMAGE_MODEL=
# MAGIC_IMAGE_PUBLIC_BASE_URL=http://localhost:8080/api/social/avatars

# DeepSeek features: truth-game and jailbreak-game AI actions.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional Tencent Cloud VOD playback configuration.
TENCENT_VOD_APP_ID=
TENCENT_VOD_FILE_ID=
TENCENT_VOD_PLAYBACK_KEY=
TENCENT_VOD_MASTER_URL=
TENCENT_VOD_PLAYBACK_URL_TTL=30m
